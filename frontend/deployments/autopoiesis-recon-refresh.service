[Unit]
Description=Autopoiesis read-only recon surface refresh (allowlisted TCP connect, 192.168.1.0/24)
After=network-online.target autopoiesis-gateway.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/data/Autopoiesis-AgentSys
EnvironmentFile=-/etc/autopoiesis.env
ExecStart=/data/Autopoiesis-AgentSys/frontend/.venv/bin/python /data/Autopoiesis-AgentSys/scripts/refresh_recon_snapshot.py
