[Unit]
Description=Autopoiesis live FortiGate event ingest
Documentation=file:///data/Autopoiesis-AgentSys/docs/FACTS_INGEST_SERVICE.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/data/Autopoiesis-AgentSys
EnvironmentFile=/etc/autopoiesis.env
Environment=PYTHONUNBUFFERED=1
Environment=FACTS_SOURCE_POLL_SECONDS=1
Environment=AUTOPOIESIS_CLICKHOUSE_DB=autopoiesis
Environment=FACTS_STATUS_FILE=/run/autopoiesis-facts-ingest/status.json
Environment=AUTOPOIESIS_ALERT_DIRECTORY=/data/autopoiesis-production/stream/alerts
RuntimeDirectory=autopoiesis-facts-ingest
RuntimeDirectoryMode=0750
StateDirectory=autopoiesis-facts-ingest
StateDirectoryMode=0750
ExecStart=/usr/bin/python3 /data/Autopoiesis-AgentSys/frontend/gateway/ingest/facts_ingest.py live
Restart=on-failure
RestartSec=10s
TimeoutStopSec=15s
KillMode=mixed
MemoryHigh=384M
MemoryMax=512M
TasksMax=64
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
