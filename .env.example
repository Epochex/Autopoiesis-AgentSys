# Production DeepSeek V4 Flash provider. DS_V4_* configures the frontend
# gateway; AUTOPOIESIS_LLM_* configures core evaluation and command-line paths.
DEEPSEEK_API_KEY=
DS_V4_BASE_URL=https://api.deepseek.com/v1
DS_V4_MODEL=deepseek-v4-flash

AUTOPOIESIS_LLM_BASE_URL=https://api.deepseek.com/v1
AUTOPOIESIS_LLM_MODEL=deepseek-v4-flash

# Optional OpenAI-compatible model endpoint reached through a local tunnel.
AUTOPOIESIS_GPU_BASE_URL=http://127.0.0.1:28000/v1
AUTOPOIESIS_GPU_API_KEY=sk-local
AUTOPOIESIS_GPU_MODEL=glm-fast

# Optional runtime paths and feature gates.
# AUTOPOIESIS_REPO_ROOT=/data/Autopoiesis-AgentSys
# AUTOPOIESIS_FRONTEND_DIST=/data/Autopoiesis-AgentSys/frontend/dist
# AUTOPOIESIS_CORS_ORIGINS=http://127.0.0.1:5173

# Live FortiGate event distribution. Apply
# Apply frontend/deployments/11-data-plane-services.yaml and set the HTTP service ClusterIP.
# REDPANDA_PUBLISH_ENABLED=1
# REDPANDA_PROXY_URL=http://10.43.x.y:8082
# AUTOPOIESIS_REDPANDA_PROXY_URL=http://10.43.x.y:8082
# AUTOPOIESIS_REDPANDA_ADMIN_URL=http://10.43.x.z:9644
# REDPANDA_TOPIC_RAW=autopoiesis.events.raw.v1
# REDPANDA_OUTBOX_DIR=/var/lib/autopoiesis-facts-ingest/outbox
# REDPANDA_OUTBOX_MAX_BYTES=536870912
# AUTOPOIESIS_REAL_DATASET_MANIFEST=/data/Autopoiesis-AgentSys/domains/network_rca/fixtures/real/manifest.json
# AUTOPOIESIS_LIVE_SYSLOG_PATH=/data/fortigate-runtime/input/fortigate.log
# AUTOPOIESIS_ENABLE_LIVE_DEVICE_ADAPTER=0
# AUTOPOIESIS_ENABLE_R230_INGESTOR=0

# Previous SELFEVO_* names remain read-only fallbacks during migration.
# Optional durable memory source. Leave unset for the deterministic in-process mode.
AUTOPOIESIS_MEMORY_DSN=
# Five protected seed priors count toward this cap but cannot be evicted. 64
# leaves 59 learned slots at today's single-digit scale and bounds future growth.
AUTOPOIESIS_MEMORY_BUDGET=64
# Optional online semantic-memory route. When enabled, startup builds an HNSW
# base from the durable memory snapshot and new versions enter an exact Flat delta.
# Requires: pip install -e '.[dense]'
AUTOPOIESIS_ENABLE_VECTOR_MEMORY=0

# Complete local node-by-node trajectory. This remains the source of truth even
# when Langfuse export is enabled.
# AUTOPOIESIS_OBSERVABILITY_PATH=/data/autopoiesis-production/network-rca-observability.jsonl
# Optional downstream Langfuse projection. Requires: pip install -e '.[observability]'
AUTOPOIESIS_ENABLE_LANGFUSE=0
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development
# LANGFUSE_SAMPLE_RATE=1.0
